# Agent Portal — environment variables
# Copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase (Settings -> API in the Supabase dashboard) -------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY, never exposed to the browser. Used by admin
# role-change actions to write profiles. (Settings -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Until the two NEXT_PUBLIC_* values are set, auth is disabled and all routes
# are open (mock mode). Setting them turns on Microsoft SSO gating + live data.

# --- Bootstrap owners -------------------------------------------------------
# Comma-separated emails always treated as `admin`, regardless of their DB row.
# Ensures you can never lock yourself out of user management.
PORTAL_OWNER_EMAILS=jacob@foundry-capital.co

# --- Microsoft (Entra ID) SSO ----------------------------------------------
# Configured in the Supabase dashboard, not here:
#   Authentication -> Providers -> Azure
#     - Client ID / Secret come from the Entra app registration
#     - Azure Tenant URL restricts sign-in to your tenant
#   Authentication -> URL Configuration
#     - Site URL:       https://agents.foundry-capital.co
#     - Redirect URLs:  https://agents.foundry-capital.co/auth/callback
#                       http://localhost:3000/auth/callback
# In the Entra app registration, the redirect URI is Supabase's callback:
#     https://<project-ref>.supabase.co/auth/v1/callback
